# MongoDB
# Local host run:
MONGODB_URI=mongodb://localhost:27017/travel_lab
DB_NAME=travel_lab

# Docker Compose uses this inside containers.
# Leave empty/commented for the local Mongo container.
# Set this to your Atlas SRV URI when running V2/V3/V4 against Atlas Search.
# DOCKER_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority

# AI provider: openai or gemini
LLM_PROVIDER=gemini

# OpenAI, optional when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini, optional when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Keep this aligned with Atlas Vector Search index dimensions.
EMBEDDING_DIMENSIONS=1536

# Legacy/unused placeholder
ANTHROPIC_API_KEY=
